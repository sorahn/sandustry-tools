{
  "version": 1,
  "repository": "sandustry-tools",
  "root": ".",
  "sources": [
    {
      "id": "active-mods",
      "authority": "repository-code",
      "include": [
        "mods/*/src/**/*.{ts,tsx,js,jsx,md}",
        "mods/*/modinfo.json",
        "mods/*/README.md",
        "mods/*/description.txt",
        "mods/*/CHANGELOG.md"
      ],
      "exclude": ["mods/signal-gate-repair/**", "mods/zoom-hotkeys/**"]
    },
    {
      "id": "browser-and-shared-code",
      "authority": "repository-code",
      "include": [
        "apps/**/*.{ts,tsx,js,jsx,md,json,css}",
        "packages/**/*.{ts,tsx,js,jsx,md,json,css}",
        "shared/**/*.{ts,tsx,js,jsx,md}",
        "scripts/**/*.{ts,tsx,js,jsx,mjs,md,json}"
      ],
      "exclude": ["**/node_modules/**", "**/dist/**", "**/build/**"]
    },
    {
      "id": "project-docs",
      "authority": "repository-documentation",
      "include": ["README.md", "AGENTS.md", "*.md", "planning/**/*.md"]
    },
    {
      "id": "sandustry-api-reference-material",
      "authority": "repository-reference",
      "include": [
        "resources/v1/**/*.js",
        "resources/v1/**/*.json",
        "resources/v1/**/*.md",
        "resources/demo/**/*.js",
        "resources/demo/**/*.json",
        "resources/demo/**/*.md",
        "resources/*.md",
        "resources/*.txt"
      ],
      "exclude": [
        "resources/**/*.png",
        "resources/**/*.webp",
        "resources/**/*.save",
        "resources/**/*.zip",
        "resources/bundle*.js"
      ]
    },
    {
      "id": "local-sandustry-types",
      "authority": "local-type-declarations",
      "include": ["types/sandustry.d.ts"]
    },
    {
      "id": "official-sandkit-docs",
      "authority": "official-api-docs",
      "type": "external-html",
      "url": "https://sandustry.com/sandkit.html",
      "enabled": true,
      "cache": "user-local",
      "refresh": "conditional-http"
    }
  ],
  "globalExclude": [
    "**/.git/**",
    "**/node_modules/**",
    "**/build/**",
    "**/dist/**",
    "artifacts/**",
    "**/*.zip",
    "**/*.png",
    "**/*.webp",
    "**/*.gif",
    "**/*.save",
    "**/*.sandustry-save",
    "**/*.ttf",
    "**/*.woff",
    "**/*.woff2",
    "**/.env*",
    "**/*secret*",
    "**/*credential*",
    "**/*token*",
    "**/*key*.pem"
  ],
  "sessionData": {
    "enabled": false,
    "paths": ["~/.codex/archived_sessions", "~/.codex/sessions"]
  }
}
