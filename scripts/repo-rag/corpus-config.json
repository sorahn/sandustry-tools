{
  "version": 1,
  "repository": "sandustry-tools",
  "root": ".",
  "sources": [
    {
      "id": "active-mods",
      "authority": "repository-code",
      "include": [
        "mods/*/src/**/*.{ts,tsx,js,jsx,md}",
        "mods/*/modinfo.json",
        "mods/*/README.md",
        "mods/*/description.txt",
        "mods/*/CHANGELOG.md"
      ],
      "exclude": ["mods/signal-gate-repair/**", "mods/zoom-hotkeys/**"]
    },
    {
      "id": "browser-and-shared-code",
      "authority": "repository-code",
      "include": [
        "apps/**/*.{ts,tsx,js,jsx,md,json,css}",
        "packages/**/*.{ts,tsx,js,jsx,md,json,css}",
        "shared/**/*.{ts,tsx,js,jsx,md}",
        "scripts/**/*.{ts,tsx,js,jsx,mjs,md,json}"
      ],
      "exclude": [
        "**/node_modules/**",
        "**/dist/**",
        "**/build/**",
        "packages/sandustry-mod-template/docs/**",
        "packages/sandustry-mod-template/SandustryTypes/**"
      ]
    },
    {
      "id": "project-docs",
      "authority": "repository-documentation",
      "include": ["README.md", "AGENTS.md", "*.md", "skills/**/*.md"]
    },
    {
      "id": "community-sandkit-docs",
      "authority": "community-api-docs",
      "include": [
        "packages/sandustry-mod-template/docs/llms.txt",
        "packages/sandustry-mod-template/docs/*.md",
        "packages/sandustry-mod-template/docs/okf/**/*.md",
        "packages/sandustry-mod-template/docs/api/**/*.md",
        "packages/sandustry-mod-template/docs/modkit/**/*.md",
        "packages/sandustry-mod-template/docs/guides/**/*.md"
      ],
      "exclude": ["packages/sandustry-mod-template/docs/full.md"]
    },
    {
      "id": "upstream-sandkit-types",
      "authority": "upstream-type-declarations",
      "include": ["packages/sandustry-mod-template/SandustryTypes/src/**/*.d.ts"]
    },
    {
      "id": "local-sandustry-types",
      "authority": "local-type-declarations",
      "include": ["types/sandustry.d.ts"]
    },
    {
      "id": "official-sandkit-docs",
      "authority": "official-api-docs",
      "type": "external-html",
      "url": "https://sandustry.com/sandkit.html",
      "enabled": true,
      "cache": "user-local",
      "refresh": "conditional-http"
    }
  ],
  "globalExclude": [
    "**/.git/**",
    "**/node_modules/**",
    "**/build/**",
    "**/dist/**",
    "artifacts/**",
    "**/*.zip",
    "**/*.png",
    "**/*.webp",
    "**/*.gif",
    "**/*.save",
    "**/*.sandustry-save",
    "**/*.ttf",
    "**/*.woff",
    "**/*.woff2",
    "**/.env*",
    "**/*secret*",
    "**/*credential*",
    "**/*token*",
    "**/*key*.pem"
  ],
  "sessionData": {
    "enabled": false,
    "paths": ["~/.codex/archived_sessions", "~/.codex/sessions"]
  }
}
