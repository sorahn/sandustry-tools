{
  "name": "sandustry-tools",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "catalog:extract": "node scripts/extract-native-catalog.mjs",
    "repo-rag:index": "bun scripts/repo-rag/index.ts index --all",
    "repo-rag:changed": "bun scripts/repo-rag/index.ts index --changed",
    "repo-rag:refresh-docs": "bun scripts/repo-rag/index.ts external refresh",
    "repo-rag:mcp": "bun scripts/repo-rag/server.ts",
    "repo-rag:status": "bun scripts/repo-rag/index.ts status",
    "repo-rag:search": "bun scripts/repo-rag/index.ts search",
    "mcp:chrome-devtools": "chrome-devtools-mcp --browser-url=http://127.0.0.1:9222 --no-usage-statistics --no-performance-crux --no-update-checks",
    "test:integration:setup": "node scripts/test/setup-sandustry-integration.mjs",
    "test:integration:splitter": "SANDUSTRY_MOD=splitter node scripts/test/sandustry-integration.mjs",
    "test:integration:view": "node scripts/test/sandustry-integration.mjs --view",
    "test:integration": "node scripts/test/sandustry-integration.mjs",
    "check": "npm run tsc && npm run tsc:tests && npm run lint && npm test",
    "format:bundles": "node scripts/format-bundles.mjs",
    "format:check": "oxfmt --check .",
    "format": "oxfmt --write .",
    "lint": "node scripts/check-jsx.mjs && oxlint --deny-warnings --ignore-pattern '**/build/**' --ignore-pattern 'resources/**' --ignore-pattern '*.zip' tests scripts types mods packages/*/src apps/blueprint-site/src",
    "prepare": "husky",
    "test": "node scripts/run-tests.mjs",
    "tsc:tests": "tsc --noEmit -p tsconfig.tests.json",
    "tsc": "tsc --noEmit",
    "visual:diff": "bun packages/sandustry-blueprint-core/tests/visual/render-visual.mjs --diff",
    "visual:render": "bun packages/sandustry-blueprint-core/tests/visual/render-visual.mjs",
    "visual:update": "bun packages/sandustry-blueprint-core/tests/visual/render-visual.mjs --update"
  },
  "dependencies": {
    "opentype.js": "1.3.4"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "bun": "^1.4.0",
    "chrome-devtools-mcp": "^1.7.0",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "fsevents": true,
    "bun@1.4.0": true,
    "esbuild@0.28.2": true
  }
}
