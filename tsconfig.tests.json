{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["react", "react-dom", "node", "bun"],
    "jsx": "react",
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "types/**/*.d.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**/*.ts",
    "**/__tests__/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "apps/sandustry-vault/**",
    "apps/blueprint-site/**",
    "packages/sandustry-ui/**",
    "**/build/**",
    "packages/sandustry-mod-template/**",
    "**/*.integration.test.ts",
    "**/*.integration.test.tsx"
  ]
}
