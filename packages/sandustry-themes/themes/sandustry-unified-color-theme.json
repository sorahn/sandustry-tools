    "terminal.ansiYellow": "#f4a460",
    "terminal.ansiBlue": "#1e90ff",
    "terminal.ansiMagenta": "#cc5cdb",
    "terminal.ansiCyan": "#00ced1",
    "terminal.ansiWhite": "#b6bcc1",
    "terminal.ansiBrightBlack": "#808080",
    "terminal.ansiBrightRed": "#ff4500",
    "terminal.ansiBrightGreen": "#7fff00",
    "terminal.ansiBrightYellow": "#ffd700",
    "terminal.ansiBrightBlue": "#8b82e0",
    "terminal.ansiBrightMagenta": "#ff66cc",
    "terminal.ansiBrightCyan": "#5dcfd6",
    "terminal.ansiBrightWhite": "#f7f7f7"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "comment.block", "comment.line", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#808080",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Control Flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.other",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#cc5cdb"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#1e90ff"
      }
    },
    {
      "name": "Types, Classes, Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "entity.name.interface"
      ],
      "settings": {
        "foreground": "#8b82e0"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
      "settings": {
        "foreground": "#66cc66"
      }
    },
    {
      "name": "Numbers, Booleans, Language Constants",
      "scope": ["constant.numeric", "constant.language", "constant.other"],
      "settings": {
        "foreground": "#ffd700"
      }
    },
    {
      "name": "Variables & Identifiers",
      "scope": ["variable", "variable.other", "variable.other.readwrite"],
      "settings": {
        "foreground": "#e8eef5"
      }
    },
    {
      "name": "Parameters & Object Properties",
      "scope": [
        "variable.parameter",
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#f4a460"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.accessor",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#00ced1"
      }
    },
    {
      "name": "HTML/JSX Tags & Components",
      "scope": ["entity.name.tag", "support.class.component"],
      "settings": {
        "foreground": "#ff66cc"
      }
    },
    {
      "name": "HTML/JSX Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#f4a460",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Regex & Escapes",
      "scope": ["string.regexp", "constant.character.escape"],
      "settings": {
        "foreground": "#5dcfd6"
      }
    },
    {
      "name": "JSON Keys",
      "scope": ["support.type.property-name.json"],
      "settings": {
        "foreground": "#f4a460"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": ["markup.heading", "punctuation.definition.heading.markdown"],
      "settings": {
        "foreground": "#ffe700",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": {
        "foreground": "#1e90ff"
      }
    },
    {
      "name": "Markdown Code",
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": {
        "foreground": "#66cc66"
      }
    }
  ]
}
