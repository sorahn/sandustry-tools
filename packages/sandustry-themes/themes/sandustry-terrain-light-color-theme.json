    "terminal.ansiMagenta": "#8a2be2",
    "terminal.ansiCyan": "#0094b3",
    "terminal.ansiWhite": "#b6bcc1",
    "terminal.ansiBrightBlack": "#808080",
    "terminal.ansiBrightRed": "#b22222",
    "terminal.ansiBrightGreen": "#1dae1d",
    "terminal.ansiBrightYellow": "#926426",
    "terminal.ansiBrightBlue": "#4a40b0",
    "terminal.ansiBrightMagenta": "#ff69b4",
    "terminal.ansiBrightCyan": "#339999",
    "terminal.ansiBrightWhite": "#fffab3"
