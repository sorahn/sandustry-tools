  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "comment.block", "comment.line", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#708090",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Control Flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.other",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#8a2be2"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#0066aa"
      }
    },
    {
      "name": "Types, Classes, Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "entity.name.interface"
      ],
      "settings": {
        "foreground": "#4a40b0"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
      "settings": {
        "foreground": "#1b5e20"
      }
    },
    {
      "name": "Numbers, Booleans, Language Constants",
      "scope": ["constant.numeric", "constant.language", "constant.other"],
      "settings": {
        "foreground": "#8b5a2b"
      }
    },
    {
      "name": "Variables & Identifiers",
      "scope": ["variable", "variable.other", "variable.other.readwrite"],
      "settings": {
        "foreground": "#181c20"
      }
    },
    {
      "name": "Parameters & Object Properties",
      "scope": [
        "variable.parameter",
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#926426"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.accessor",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#007a99"
      }
    },
    {
      "name": "HTML/JSX Tags & Components",
      "scope": ["entity.name.tag", "support.class.component"],
      "settings": {
        "foreground": "#a02050"
      }
    },
    {
      "name": "HTML/JSX Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#926426",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Regex & Escapes",
      "scope": ["string.regexp", "constant.character.escape"],
      "settings": {
        "foreground": "#007a99"
      }
    },
    {
      "name": "JSON Keys",
      "scope": ["support.type.property-name.json"],
      "settings": {
        "foreground": "#926426"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": ["markup.heading", "punctuation.definition.heading.markdown"],
      "settings": {
        "foreground": "#8b5a2b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": {
        "foreground": "#0066aa"
      }
    },
    {
      "name": "Markdown Code",
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": {
        "foreground": "#1b5e20"
      }
    }
  ]
}
