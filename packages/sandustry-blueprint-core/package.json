{
  "name": "@daryl.roberts/sandustry-blueprint-core",
  "version": "0.1.4",
  "private": false,
  "description": "Shared Sandustry blueprint encoding and rendering core",
  "homepage": "https://github.com/sorahn/sandustry-blueprint-core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sorahn/sandustry-blueprint-core.git"
  },
  "files": [
    "dist",
    "assets"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "lint": "oxlint src tests",
    "tsc": "tsc --noEmit",
    "test": "bun test src tests"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
